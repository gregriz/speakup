<!doctype html><html><head><meta charset='utf-8'/><meta name='viewport' content='width=device-width,initial-scale=1'/><title>Check-in</title><link rel='stylesheet' href='/styles.css'/></head><body>
<main class='container'><h2>Check-in</h2><a href='/admin'>← Back</a>
<form class='card row' method='get' action='/check-in'><input name='q' placeholder='Search name/email/ticket ID' value='<%= q || ticketId || "" %>'/><button class='btn'>Search</button></form>
<% if(ticket){ %>
<div class='card'>
<p><b><%= ticket.full_name %></b> · <%= ticket.email %></p>
<p>Ticket: <%= ticket.ticket_id %></p>
<p>Status: <span class='tag <%= ticket.status === "checked_in" ? "danger" : "ok" %>'><%= ticket.status === 'valid' ? 'valid' : 'already used' %></span></p>
<% if(ticket.status === 'valid'){ %><form method='post' action='/check-in/<%= ticket.ticket_id %>/use'><button class='btn'>Mark as checked in</button></form><% } %>
</div>
<% } else if(q || ticketId){ %>
<p class='error'>Ticket not found.</p>
<% } %>
</main></body></html>
