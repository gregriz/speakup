<!doctype html><html><head><meta charset='utf-8'/><meta name='viewport' content='width=device-width,initial-scale=1'/><title>Tickets</title><link rel='stylesheet' href='/styles.css'/></head><body>
<main class='container'><h2>Tickets</h2><a href='/admin'>← Back</a>
<div class='table-wrap'><table><thead><tr><th>Ticket ID</th><th>Owner</th><th>Email</th><th>Status</th><th>Issued</th><th>QR</th></tr></thead><tbody>
<% tickets.forEach((t)=> { %>
<tr><td><%= t.ticket_id %></td><td><%= t.full_name %></td><td><%= t.email %></td><td><%= t.status %></td><td><%= t.issued_at %></td><td><img src='<%= t.qr_code %>' width='64'/></td></tr>
<% }) %></tbody></table></div>
</main></body></html>
