<!doctype html><html><head><meta charset='utf-8'/><meta name='viewport' content='width=device-width,initial-scale=1'/><title>Admin Settings</title><link rel='stylesheet' href='/styles.css'/></head><body>
<main class='container'><h2>Admin Settings</h2><a href='/admin'>← Back</a>
<% if(ok){ %><p class='ok'>Settings saved.</p><% } %>
<form class='card form' method='post'>
<input name='event_name' value='<%= settings.event_name %>' required/>
<textarea name='event_description' required><%= settings.event_description %></textarea>
<input type='date' name='event_date' value='<%= settings.event_date %>' required/>
<input name='event_time' value='<%= settings.event_time %>' required/>
<input name='event_location' value='<%= settings.event_location %>' required/>
<input name='iban' value='<%= settings.iban %>' required/>
<input name='account_name' value='<%= settings.account_name %>' required/>
<input type='number' step='0.01' name='price_per_ticket' value='<%= settings.price_per_ticket %>' required/>
<input type='number' name='max_tickets' value='<%= settings.max_tickets %>' required/>
<input type='email' name='organizer_email' value='<%= settings.organizer_email %>' required/>
<button class='btn'>Save</button></form>
</main></body></html>
