<!doctype html><html><head><meta charset='utf-8'/><meta name='viewport' content='width=device-width,initial-scale=1'/><title>Register</title><link rel='stylesheet' href='/styles.css'/></head><body>
<main class='container'>
<h2>Registration</h2>
<% if (error) { %><p class='error'><%= error %></p><% } %>
<form class='card form' method='post' action='/register'>
<input name='first_name' placeholder='First name' required value='<%= form.first_name || "" %>'/>
<input name='last_name' placeholder='Last name' required value='<%= form.last_name || "" %>'/>
<input type='email' name='email' placeholder='Email' required value='<%= form.email || "" %>'/>
<input name='phone' placeholder='Phone (optional)' value='<%= form.phone || "" %>'/>
<input type='number' name='quantity' min='1' max='<%= settings.max_tickets %>' required value='<%= form.quantity || 1 %>'/>
<textarea name='notes' placeholder='Notes (optional)'><%= form.notes || "" %></textarea>
<label><input type='checkbox' name='consent' required/> I consent to privacy policy processing.</label>
<button class='btn' type='submit'>Continue to payment</button>
</form></main></body></html>
